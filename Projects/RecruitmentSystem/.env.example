AI_MATCHING_WEIGHT_LANGUAGES=5
AI_MATCHING_WEIGHT_SOFT_SKILLS=5
AI_MATCHING_WEIGHT_KEYWORDS=5
AI_AMQP_INITIALIZE_TOPOLOGY=true
AI_AMQP_INBOUND_EXCHANGE=recruitment.events
AI_AMQP_OUTBOUND_EXCHANGE=ai.events
AI_AMQP_QUEUE=ai-service.events
AI_AMQP_DLX=ai.dlx
AI_AMQP_DLQ=ai-service.events.dlq
AI_RESUME_MAX_FILE_SIZE=10MB
AI_RESUME_MAX_REQUEST_SIZE=11MB
AI_RESUME_MAX_EXTRACTED_CHARACTERS=200000
