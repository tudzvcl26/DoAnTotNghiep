APPLICATION_USER_CLIENT_READ_TIMEOUT_MS=5000
APPLICATION_COMPANY_CLIENT_CONNECT_TIMEOUT_MS=2000
APPLICATION_COMPANY_CLIENT_READ_TIMEOUT_MS=5000
